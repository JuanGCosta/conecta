rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() {
      return request.auth != null;
    }
    function verified() {
      return signed() && request.auth.token.email_verified == true;
    }
    function profileValid(p) {
      return p.keys().hasOnly(['ownerUid','name','category','city','neighborhood','hasWhatsapp','bio','photo','updatedAt'])
        && p.ownerUid == request.auth.uid
        && p.name is string && p.name.size() > 1 && p.name.size() <= 80
        && p.category is string && p.category.size() > 1 && p.category.size() <= 40
        && p.city is string && p.city.size() > 1 && p.city.size() <= 60
        && p.neighborhood is string && p.neighborhood.size() <= 80
        && p.hasWhatsapp is bool
        && p.bio is string && p.bio.size() <= 500
        && p.photo is string && p.photo.size() <= 350000
        && p.updatedAt == request.time;
    }
    match /profiles/{userId} {
      allow read: if true;
      allow create: if verified() && userId == request.auth.uid && profileValid(request.resource.data);
      allow update: if verified() && userId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid && profileValid(request.resource.data);
      allow delete: if verified() && userId == request.auth.uid;
    }
    match /profiles/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if verified() && request.auth.uid == reviewId && reviewId != userId
        && exists(/databases/$(database)/documents/profiles/$(userId))
        && validReview(request.resource.data);
      allow update: if verified() && request.auth.uid == reviewId && reviewId != userId
        && resource.data.authorUid == request.auth.uid && validReview(request.resource.data);
      allow delete: if verified() && request.auth.uid == reviewId;
    }
    function validReview(r) {
      return r.keys().hasOnly(['authorUid','authorName','rating','comment','updatedAt'])
        && r.authorUid == request.auth.uid
        && r.authorName is string && r.authorName.size() > 0 && r.authorName.size() <= 70
        && r.rating is int && r.rating >= 1 && r.rating <= 5
        && r.comment is string && r.comment.size() > 0 && r.comment.size() <= 500
        && r.updatedAt == request.time;
    }
    // Phone numbers are not part of the publicly-readable professional profile.
    // Verified accounts can look up a specific professional's contact; bulk listing is blocked.
    match /contacts/{userId} {
      allow get: if verified();
      allow list: if false;
      allow create, update: if verified() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['ownerUid','phone','updatedAt'])
        && request.resource.data.ownerUid == userId
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{0,20}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if verified() && request.auth.uid == userId;
    }
    function participant(data) {
      return verified() && request.auth.uid in data.participants;
    }
    function threadStatus(data) {
      return data.get('status','accepted');
    }
    function validThread(data) {
      return data.keys().hasOnly(['customerId','providerId','participants','customerName','providerName','lastMessage','lastSenderId','createdAt','updatedAt','status'])
        && data.customerId is string && data.providerId is string
        && data.customerId != data.providerId
        && data.participants == [data.customerId,data.providerId]
        && data.customerName is string && data.customerName.size() <= 70
        && data.providerName is string && data.providerName.size() <= 80
        && data.lastMessage is string && data.lastMessage.size() > 0 && data.lastMessage.size() <= 1000
        && data.lastSenderId == request.auth.uid && data.updatedAt == request.time
        && threadStatus(data) in ['pending','accepted','declined'];
    }
    function stableThread(before,after) {
      return after.customerId == before.customerId
        && after.providerId == before.providerId
        && after.participants == before.participants
        && after.customerName == before.customerName
        && after.providerName == before.providerName
        && after.createdAt == before.createdAt;
    }
    match /chats/{chatId} {
      allow get, list: if participant(resource.data);
      allow create: if verified() && chatId == request.resource.data.customerId + '_' + request.resource.data.providerId
        && request.auth.uid == request.resource.data.customerId
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.providerId))
        && validThread(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if participant(resource.data)
        && request.resource.data.keys().hasOnly(['customerId','providerId','participants','customerName','providerName','lastMessage','lastSenderId','createdAt','updatedAt','status'])
        && stableThread(resource.data,request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
          // Only the professional may authorize or refuse the request.
          (request.auth.uid == resource.data.providerId
            && threadStatus(resource.data) == 'pending'
            && threadStatus(request.resource.data) in ['accepted','declined']
            && request.resource.data.lastMessage == resource.data.lastMessage
            && request.resource.data.lastSenderId == resource.data.lastSenderId)
          ||
          // Once authorized, both participants can send ordinary messages.
          (threadStatus(resource.data) == 'accepted'
            && threadStatus(request.resource.data) == 'accepted'
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 1000)
        );
      allow delete: if false;
      match /messages/{messageId} {
        allow get, list: if participant(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if verified()
          && request.resource.data.keys().hasOnly(['senderId','text','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && participant(getAfter(/databases/$(database)/documents/chats/$(chatId)).data)
          && (
            // Exactly one first message with a fixed document id when creating a request.
            (messageId == 'intro'
              && threadStatus(getAfter(/databases/$(database)/documents/chats/$(chatId)).data) == 'pending'
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.customerId == request.auth.uid
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.createdAt == request.time
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastSenderId == request.auth.uid
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessage == request.resource.data.text)
            ||
            (messageId != 'intro'
              && threadStatus(getAfter(/databases/$(database)/documents/chats/$(chatId)).data) == 'accepted'
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.updatedAt == request.time
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastSenderId == request.auth.uid
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessage == request.resource.data.text)
          );
        allow update, delete: if false;
      }
    }

  }
}
