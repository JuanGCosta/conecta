rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() {
      return request.auth != null;
    }
    function verified() {
      return signed() && request.auth.token.email_verified == true;
    }
    function profileValid(p) {
      return p.keys().hasOnly(['ownerUid','name','category','city','neighborhood','hasWhatsapp','bio','photo','cover','updatedAt'])
        && p.ownerUid == request.auth.uid
        && p.name is string && p.name.size() > 1 && p.name.size() <= 80
        && p.category is string && p.category.size() > 1 && p.category.size() <= 40
        && p.city == 'São José dos Campos'
        && p.neighborhood is string && p.neighborhood.size() <= 80
        && p.hasWhatsapp is bool
        && p.bio is string && p.bio.size() <= 500
        && p.photo is string && p.photo.size() <= 350000
        && (p.photo == '' || p.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && p.get('cover','') is string && p.get('cover','').size() <= 95000
        && (p.get('cover','') == '' || p.get('cover','').matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && p.updatedAt == request.time;
    }
    // V24: só conteúdo publicado de verdade fica visível aos visitantes.
    function imageURLs(p, maximum) {
      return p is list && p.size() <= maximum
        && (p.size()<1 || validPhotoURL(p[0]))
        && (p.size()<2 || validPhotoURL(p[1]))
        && (p.size()<3 || validPhotoURL(p[2]))
        && (p.size()<4 || validPhotoURL(p[3]))
        && (p.size()<5 || validPhotoURL(p[4]))
        && (p.size()<6 || validPhotoURL(p[5]));
    }
    function validPhotoURL(src) {
      return src is string && ((src.size() < 1200
        && src.matches('^https://firebasestorage\\.googleapis\\.com/.*'))
        || (src.size() <= 81000 && src.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
    }
    function validRequest(p) {
      return p.keys().hasOnly(['ownerUid','owner','title','category','city','description','photos','status','createdAt','updatedAt'])
        && p.ownerUid == request.auth.uid
        && p.owner is string && p.owner.size() > 0 && p.owner.size() <= 70
        && p.title is string && p.title.size() >= 5 && p.title.size() <= 90
        && p.category in ['Reformas','Elétrica','Hidráulica','Limpeza','Pintura','Jardinagem','Montagem','Tecnologia','Beleza','Fotografia','Aulas','Marcenaria','Ar-condicionado','Fretes','Pet care','Costura','Eventos','Automotivo','Saúde','Outros']
        && p.city == 'São José dos Campos'
        && p.description is string && p.description.size() >= 10 && p.description.size() <= 1000
        && imageURLs(p.photos,4)
        && p.status == 'open'
        && p.createdAt == request.time && p.updatedAt == request.time;
    }
    match /requests/{requestId} {
      allow get, list: if true;
      allow create: if verified() && validRequest(request.resource.data);
      allow delete: if verified() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      match /offers/{providerId} {
        allow get: if verified() && (
          request.auth.uid == providerId ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.ownerUid == request.auth.uid
        );
        allow list: if verified() &&
          get(/databases/$(database)/documents/requests/$(requestId)).data.ownerUid == request.auth.uid;
        allow create: if verified() && request.auth.uid == providerId
          && exists(/databases/$(database)/documents/profiles/$(providerId))
          && get(/databases/$(database)/documents/requests/$(requestId)).data.ownerUid != request.auth.uid
          && get(/databases/$(database)/documents/requests/$(requestId)).data.status == 'open'
          && request.resource.data.keys().hasOnly(['providerUid','providerName','message','createdAt'])
          && request.resource.data.providerUid == providerId
          && request.resource.data.providerName == get(/databases/$(database)/documents/profiles/$(providerId)).data.name
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 15
          && request.resource.data.message.size() <= 400
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if verified() && (
          request.auth.uid == providerId ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.ownerUid == request.auth.uid
        );
      }
    }
    match /works/{workId} {
      allow get, list: if true;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['ownerUid','title','description','photos','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 90
        && request.resource.data.description is string && request.resource.data.description.size() >= 5 && request.resource.data.description.size() <= 650
        && imageURLs(request.resource.data.photos,6)
        && request.resource.data.createdAt == request.time;
      allow delete: if verified() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }
    match /users/{userId}/favorites/{providerId} {
      allow get, list: if verified() && request.auth.uid == userId;
      allow create: if verified() && request.auth.uid == userId && providerId != userId
        && exists(/databases/$(database)/documents/profiles/$(providerId))
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if verified() && request.auth.uid == userId;
      allow update: if false;
    }
    match /profiles/{userId} {
      allow read: if true;
      allow create: if verified() && userId == request.auth.uid && profileValid(request.resource.data);
      allow update: if verified() && userId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid && profileValid(request.resource.data);
      allow delete: if verified() && userId == request.auth.uid;
    }
    match /profiles/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if verified() && request.auth.uid == reviewId && reviewId != userId
        && exists(/databases/$(database)/documents/profiles/$(userId))
        && validReview(request.resource.data);
      allow update: if verified() && request.auth.uid == reviewId && reviewId != userId
        && resource.data.authorUid == request.auth.uid && validReview(request.resource.data);
      allow delete: if verified() && request.auth.uid == reviewId;
    }
    function validReview(r) {
      return r.keys().hasOnly(['authorUid','authorName','rating','comment','updatedAt'])
        && r.authorUid == request.auth.uid
        && r.authorName is string && r.authorName.size() > 0 && r.authorName.size() <= 70
        && r.rating is int && r.rating >= 1 && r.rating <= 5
        && r.comment is string && r.comment.size() > 0 && r.comment.size() <= 500
        && r.updatedAt == request.time;
    }
    // Phone numbers are not part of the publicly-readable professional profile.
    // Verified accounts can look up a specific professional's contact; bulk listing is blocked.
    // Phone belongs only to its owner or to a client explicitly approved by the professional.
    function approvedContact(providerId) {
      return verified() && exists(/databases/$(database)/documents/chats/$(request.auth.uid + '_' + providerId))
        && get(/databases/$(database)/documents/chats/$(request.auth.uid + '_' + providerId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/chats/$(request.auth.uid + '_' + providerId)).data.providerId == providerId
        && get(/databases/$(database)/documents/chats/$(request.auth.uid + '_' + providerId)).data.status == 'accepted';
    }
    match /contacts/{userId} {
      allow get: if verified() && (request.auth.uid == userId || approvedContact(userId));
      allow list: if false;
      allow create, update: if verified() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['ownerUid','phone','updatedAt'])
        && request.resource.data.ownerUid == userId
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{0,20}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if verified() && request.auth.uid == userId;
    }
    function participant(data) {
      return verified() && request.auth.uid in data.participants;
    }
    function threadStatus(data) {
      return data.get('status','accepted');
    }
    function validThread(data) {
      return data.keys().hasOnly(['customerId','providerId','participants','customerName','providerName','lastMessage','lastSenderId','createdAt','updatedAt','status','pendingCount'])
        && data.customerId is string && data.providerId is string
        && data.customerId != data.providerId
        && data.participants == [data.customerId,data.providerId]
        && data.customerName is string && data.customerName.size() <= 70
        && data.providerName is string && data.providerName.size() <= 80
        && data.lastMessage is string && data.lastMessage.size() > 0 && data.lastMessage.size() <= 1000
        && data.lastSenderId == request.auth.uid && data.updatedAt == request.time
        && threadStatus(data) in ['pending','accepted','declined']
        && (!('pendingCount' in data) || (data.pendingCount is int && data.pendingCount >= 1 && data.pendingCount <= 3));
    }
    function stableThread(before,after) {
      return after.customerId == before.customerId
        && after.providerId == before.providerId
        && after.participants == before.participants
        && after.customerName == before.customerName
        && after.providerName == before.providerName
        && after.createdAt == before.createdAt;
    }
    match /chats/{chatId} {
      allow get, list: if participant(resource.data);
      allow create: if verified() && chatId == request.resource.data.customerId + '_' + request.resource.data.providerId
        && request.auth.uid == request.resource.data.customerId
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.providerId))
        && validThread(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.pendingCount == 1
        && request.resource.data.createdAt == request.time;
      allow update: if participant(resource.data)
        && request.resource.data.keys().hasOnly(['customerId','providerId','participants','customerName','providerName','lastMessage','lastSenderId','createdAt','updatedAt','status','pendingCount'])
        && stableThread(resource.data,request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
          // Only the professional may authorize or refuse the request.
          (request.auth.uid == resource.data.providerId
            && threadStatus(resource.data) == 'pending'
            && threadStatus(request.resource.data) in ['accepted','declined']
            && request.resource.data.lastMessage == resource.data.lastMessage
            && request.resource.data.lastSenderId == resource.data.lastSenderId
            && request.resource.data.get('pendingCount',1) == resource.data.get('pendingCount',1))
          ||
          // The customer may send up to 3 initial messages while the request is pending.
          (threadStatus(resource.data) == 'pending'
            && threadStatus(request.resource.data) == 'pending'
            && request.auth.uid == resource.data.customerId
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 1000
            && request.resource.data.pendingCount is int
            && request.resource.data.pendingCount == resource.data.get('pendingCount',1) + 1
            && request.resource.data.pendingCount <= 3)
          ||
          // Once authorized, both participants can send ordinary messages.
          (threadStatus(resource.data) == 'accepted'
            && threadStatus(request.resource.data) == 'accepted'
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 1000
            && request.resource.data.get('pendingCount',1) == resource.data.get('pendingCount',1))
        );
      allow delete: if false;
      match /messages/{messageId} {
        allow get, list: if participant(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if verified()
          && request.resource.data.keys().hasOnly(['senderId','text','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && participant(getAfter(/databases/$(database)/documents/chats/$(chatId)).data)
          && (
            // Exactly one first message with a fixed document id when creating a request.
            (messageId == 'intro'
              && threadStatus(getAfter(/databases/$(database)/documents/chats/$(chatId)).data) == 'pending'
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.customerId == request.auth.uid
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.createdAt == request.time
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastSenderId == request.auth.uid
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessage == request.resource.data.text)
            ||
            (messageId != 'intro'
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.updatedAt == request.time
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastSenderId == request.auth.uid
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessage == request.resource.data.text
              && (
                (threadStatus(getAfter(/databases/$(database)/documents/chats/$(chatId)).data) == 'accepted')
                ||
                (threadStatus(getAfter(/databases/$(database)/documents/chats/$(chatId)).data) == 'pending'
                  && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.customerId == request.auth.uid
                  && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.pendingCount is int
                  && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.pendingCount == get(/databases/$(database)/documents/chats/$(chatId)).data.get('pendingCount',1) + 1
                  && ((messageId == 'pending-2' && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.pendingCount == 2)
                      || (messageId == 'pending-3' && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.pendingCount == 3)))
              ))
          );
        allow update, delete: if false;
      }
    }


    // Requests made by the data subject. This records a request, not an automatic deletion.
    // Administrative fulfillment requires verified identity and a separate cleanup workflow.
    function validPrivacyRequest(r, userId) {
      return r.keys().hasOnly(['ownerUid','email','kind','status','createdAt'])
        && r.ownerUid == userId
        && r.email == request.auth.token.email
        && r.kind in ['access','deletion']
        && r.status == 'pending'
        && r.createdAt == request.time;
    }
    match /privacyRequests/{userId} {
      allow get: if verified() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if verified() && request.auth.uid == userId
        && validPrivacyRequest(request.resource.data, userId);
      allow delete: if false;
    }
  }
}
