rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function safeJpeg() {
      return request.resource != null
        && request.resource.size <= 800 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
    // Fotos dos pedidos e portfólios são públicas porque compõem anúncios públicos.
    match /request-images/{userId}/{requestId}/{fileName} {
      allow read: if true;
      allow create: if verified() && request.auth.uid == userId
        && fileName.matches('^[0-3]\\.jpg$') && safeJpeg();
      allow delete: if verified() && request.auth.uid == userId;
      allow update: if false;
    }
    match /work-images/{userId}/{workId}/{fileName} {
      allow read: if true;
      allow create: if verified() && request.auth.uid == userId
        && fileName.matches('^[0-5]\\.jpg$') && safeJpeg();
      allow delete: if verified() && request.auth.uid == userId;
      allow update: if false;
    }
  }
}
